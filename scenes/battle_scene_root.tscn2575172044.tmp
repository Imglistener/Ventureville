[sub_resource type="GDScript" id="GDScript_0jxt2"]
script/source = "class_name HPSANManager extends Node
@onready var stat_manager: Stat_Manager = %\"Stat Manager\"
@onready var enemy_stat_manager: Stat_Manager = %\"Enemy Stat Manager\"


var entity: Node

var HP: int
var SAN: int

var MAX_HP: int
var MAX_SAN: int

func _ready() -> void:
	if not stat_manager.is_node_ready():
		await stat_manager.ready
	if not enemy_stat_manager.is_node_ready():
		await enemy_stat_manager.ready
	MAX_HP = HP
	MAX_SAN = SAN
"

[sub_resource type="GDScript" id="GDScript_4wwdq"]
script/source = "class_name Stat_Manager extends Node

@onready var hp_san_manager: HP_SAN_Manager = %\"HP-SAN Manager\"
@onready var enemy_hp_san_manager: HP_SAN_Manager = %\"Enemy HP-SAN Manager\"

@export var Entity : Resource
var Enemy_Stats: Array

func _ready() -> void:
	pass
"

