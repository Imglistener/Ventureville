[sub_resource type="GDScript" id="GDScript_jt4d8"]
script/source = "class_name Sanbar extends TextureProgressBar

@onready var source = %Enemy
@onready var health: Label = $Label
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if not source.is_node_ready():
		await source.ready
	self.max_value = source.Enemy_basestats[\"eSanity\"]
	self.value = min_value
	

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	health.text = str(int(self.max_value - self.value))
	
func take_damage(amount: int) -> void:
	self.value = self.value + amount
	

func _on_item_pressed() -> void:
	take_damage(15) # Replace with function body.
"

