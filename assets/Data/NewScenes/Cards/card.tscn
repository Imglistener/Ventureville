[sub_resource type="Shader" id="Shader_80gmr"]
code = "shader_type canvas_item;
render_mode blend_add;

uniform vec4 glow_color : source_color = vec4(0.3, 0.7, 1.0, 1.0);
uniform float thickness : hint_range(0.01, 0.2) = 0.06;
uniform float softness : hint_range(0.005, 0.1) = 0.03;
uniform float intensity : hint_range(0.0, 3.0) = 1.5;
uniform float pulse_speed : hint_range(0.0, 5.0) = 1.5;
uniform float pulse_amount : hint_range(0.0, 0.5) = 0.15;
uniform float fade_strength : hint_range(0.0, 4.0) = 1.5; // 0 = no fade, higher = tighter fade
uniform float fade_bias : hint_range(0.0, 1.0) = 0.2;     // lifts the fade floor at center

void fragment() {
    vec2 uv = UV;

    // Edge glow
    float dist_x = min(uv.x, 1.0 - uv.x);
    float dist_y = min(uv.y, 1.0 - uv.y);
    float dist = min(dist_x, dist_y);
    float glow = 1.0 - smoothstep(thickness, thickness + softness, dist);

    // Distance from center [0,1] where 0 = center, 1 = corner
    vec2 centered = abs(uv - 0.5) * 2.0;
    float center_dist = max(centered.x, centered.y); // use max for rectangular feel
    float fade = 1.0 - smoothstep(fade_bias, 1.0, pow(center_dist, 1.0 / max(fade_strength, 0.001)));

    float pulse = 1.0 + sin(TIME * pulse_speed) * pulse_amount;
    float alpha = glow * fade * intensity * pulse;
    COLOR = vec4(glow_color.rgb, alpha * glow_color.a);
}"

